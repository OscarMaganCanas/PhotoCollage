<resources>
    <style name="Theme.PhotoCollage" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/acento</item>
        <item name="colorPrimaryVariant">@color/acento_oscuro</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/seleccion</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/fondo_oscuro</item>
        <item name="android:statusBarColor">@color/fondo_oscuro</item>
        <item name="android:navigationBarColor">@color/fondo_oscuro</item>
    </style>

    <!-- Botones compactos para que quepan 4 por fila en cualquier pantalla -->
    <style name="BotonControl" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="BotonControl.Peligro">
        <item name="backgroundTint">@color/peligro</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BotonControl.Filtro">
        <item name="backgroundTint">@color/filtro</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="EtiquetaSlider">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_blanco</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
